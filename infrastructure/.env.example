# Copy to .env and fill in. Never commit .env.

# --- Drone ---------------------------------------------------------------
# Serial number of the aircraft; selects the OSD topic the telemetry bridge reads.
DRONE_SN=

# --- Local broker (defaults are correct for the single container) --------
LOCAL_BROKER_HOST=127.0.0.1
LOCAL_BROKER_PORT=1883
LOCAL_PUBLISH_TOPIC=drone/telemetry/position
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# --- DJI Cloud API app (developer.dji.com → Apps), used by dock-handshake --
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=
ORG_ID=
ORG_NAME=
# Set once and keep it: a new value makes the dock see a new workspace.
WORKSPACE_ID=