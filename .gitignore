# ---------------------------------------------------------------- Secrets
# Real configuration values. Only .env.example is committed.
.env
infrastructure/.env

# Generated broker credentials (Phase B: broker auth)
infrastructure/mosquitto/passwd

# ESDK RSA key pair, if generated outside a container
pub_key
private_key

# ---------------------------------------------------------------- C++ build output
# CMake builds inside the Docker image; nothing it produces belongs here.
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.o
*.obj

# The compiled server. Anchored to the build output so it can't match source folders.
services/edge-server/server

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

